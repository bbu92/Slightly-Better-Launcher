        </shape>
    </item>

    <!-- greeting, clock, weather and date -->
    <item android:top="30dp" android:start="58dp" android:width="108dp" android:height="6dp" android:gravity="top|start">
        <shape android:shape="rectangle"><solid android:color="#55FFFFFF" /><corners android:radius="3dp" /></shape>
