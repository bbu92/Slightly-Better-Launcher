<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center_vertical" android:height="26dp">
        <shape android:shape="rectangle">
            <solid android:color="#668A8A90" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:gravity="center_vertical|start" android:width="20dp" android:height="20dp" android:left="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
