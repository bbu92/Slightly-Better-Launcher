<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg">

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="@color/ink_ff"
        android:textSize="48sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 300"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/ink_8c"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="@color/ink_ff"
                        android:textSize="52sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="@color/ink_b3"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/ink_33" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:orientation="vertical">

                        <!-- Weather where the TV is, above the date. -->
                        <TextView
                            android:id="@+id/weather"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="3dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:drawablePadding="7dp"
                            android:drawableTint="@color/ink_e6"
                            android:textColor="@color/ink_e6"
                            android:textSize="15sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:format12Hour="@string/date_format"
                            android:format24Hour="@string/date_format"
                            android:textColor="@color/ink_a6"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 400"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <!-- The TV's AirPlay name; always open, and it follows the name set in the AirPlay app. -->
                <TextView
                    android:id="@+id/btnAirplay"
                    style="@style/TopButton"
                    android:maxWidth="240dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:drawableStart="@drawable/ic_airplay"
                    android:nextFocusDown="@+id/grid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />

            <!-- Connected inputs, hung under the dock band; placed in code (MainActivity.placeInputsRow). -->
            <LinearLayout
                android:id="@+id/inputsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Hero of the focused favourite: a picture fading out to the left on the right, the details on the left. -->
    <FrameLayout
        android:id="@+id/featured"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:paddingStart="68dp"
        android:paddingEnd="54dp"
        android:alpha="0"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone">

        <com.bbu.sbl.FadeLayout
            android:id="@+id/featuredArt"
            android:layout_width="420dp"
            android:layout_height="match_parent"
            android:layout_gravity="end">

            <ImageView
                android:id="@+id/featuredImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <TextureView
                android:id="@+id/featuredVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.01" />
        </com.bbu.sbl.FadeLayout>

        <LinearLayout
            android:id="@+id/featuredInfo"
            android:layout_width="520dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:gravity="top"
            android:paddingTop="8dp"
            android:duplicateParentState="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/featuredApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/ink_b3"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.16"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/featuredTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/ink_ff"
                android:textSize="26sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 300"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/featuredMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/ink_e6"
                android:textSize="14sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/featuredDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/ink_a6"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.1"
                android:fontFamily="@font/outfit" />

            <ProgressBar
                android:id="@+id/featuredProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="240dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressTint="@color/ink_ff"
                android:progressBackgroundTint="@color/ink_44" />
        </LinearLayout>

        <!-- Fixed above the dock band, so the button and the dots stay put while the cards change. -->
        <LinearLayout
            android:id="@+id/featuredActions"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="2dp"
            android:gravity="center_vertical"
            android:duplicateParentState="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/featuredButton"
                style="@style/InputPill"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:duplicateParentState="true"
                android:focusable="false"
                android:clickable="false"
                android:text="@string/continue_action" />

            <TextView
                android:id="@+id/featuredDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Soft glow along the bottom edge: the collapsed inputs row's hint that something is there. -->
    <View
        android:id="@+id/inputsGlow"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="72dp"
        android:background="@drawable/inputs_glow"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.bbu.sbl.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
